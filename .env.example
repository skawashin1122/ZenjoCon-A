# LINE Developers の「チャネル基本設定」「Messaging API設定」から取得する
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 空欄のままだと「ドライラン」：LINEには送らず、ログと outbox テーブルに記録するだけ
# DB の保存先
MAMORI_DB_PATH=/var/lib/mamorinet/mamorinet.sqlite3
# 公開URL（利用規約・もしもカードへのリンクに使う）
MAMORI_PUBLIC_URL=https://example.sslip.io
# 見守り判定・地震監視の間隔（秒）
MAMORI_WATCH_INTERVAL=300
MAMORI_QUAKE_INTERVAL=60
# 地震監視を止めたいときは 0
MAMORI_QUAKE_ENABLED=1
# 気象庁の市町村コード（日南市）と、安否確認を送る震度
MAMORI_CITY_CODE=4520400
MAMORI_QUAKE_THRESHOLD=5-
